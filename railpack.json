{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "pwd",
        "ls -la",
        "cd /app && ls -la",
        "cd /app && bun install --frozen-lockfile"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "bun run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "bun run release && cd apps/server && bun run start"
  }
}